        "en" : { "stringUnit" : { "state" : "translated", "value" : "Add timer" } }
      }
    },
    "settings.timer.autoChain" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch mit nächstem Timer fortsetzen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically continue with the next timer" } }
      }
    },
    "settings.timer.behavior" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verhalten" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Behavior" } }
      }
    },
    "settings.timer.chainHint" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Reihenfolge der Liste bestimmt die Kette beim automatischen Fortsetzen. Die Checkbox markiert Presets, deren Sitzungen als Fokuszeit ins Obsidian-Daily geloggt werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The list order defines the auto-continue chain. The checkbox marks presets whose sessions are logged as focus time in the Obsidian daily note." } }
      }
    },
