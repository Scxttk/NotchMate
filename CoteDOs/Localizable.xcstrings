      }
    },
    "settings.resetData.done" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurückgesetzt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset complete." } }
      }
    },
    "settings.spectrum.header" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sound-Spektrum" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio spectrum" } }
      }
    },
    "settings.spectrum.hint" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "„Nur Spektrum“ ersetzt das Mini-Cover in der eingeklappten Notch durch ein breiteres Spektrum mit mehr Balken — der Musik-Tab behält sein Cover. Die Farben der Balken kommen immer vom Album-Cover. Mit ⌥⌘S nimmt sich das Spektrum den ganzen Bildschirm und hält ihn wach; sobald du zurückkommst oder die Musik aus ist, sperrt der Mac." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Spectrum instead of the cover” swaps the mini cover in the collapsed notch for a wider spectrum with more bars — the music tab keeps its cover. The bars always take their colors from the album cover. ⌥⌘S hands the whole screen to the spectrum and keeps it awake; the moment you come back or the music stops, the Mac locks." } }
      }
    },
    "settings.spectrum.pillOnly" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur Spektrum statt Cover" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spectrum instead of the cover" } }
      }
    },
    "settings.spectrum.pillWidth" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Breite" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Width" } }
      }
    },
    "settings.suppressOSD" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Lautstärke & Helligkeit nur in der Notch (Bedienungshilfen nötig)" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Volume & brightness in the notch only (needs Accessibility)" } }
      }
    },
    "settings.tabs.header" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tabs" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tabs" } }
      }
    },
    "settings.tabs.hint" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deaktivierte Tabs verschwinden aus der Notch. Mindestens ein Tab bleibt immer aktiv." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Disabled tabs vanish from the notch. At least one tab always stays on." } }
      }
    },
    "settings.timer" : {
      "localizations" : {
